---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Timeline: newest period first
const timeline = [
  {
    years: "2026 – 2027",
    title: "Umschulung zur Fachinformatikerin für Anwendungsentwicklung",
    place: "Berufsförderungswerk Oberhausen",
    text: "Java, SQL und Webentwicklung.\nPraktikum bei der Bruckmann Steuerungstechnik GmbH (Oktober bis Dezember 2026).",
    icon: "💻",
    quote: "",
  },
  {
    years: "2001 – heute",
    title: "Verkehrspilotin, seit 2019 Kapitänin",
    place: "Lufthansa CityLine, Düsseldorf",
    text: "Internationaler und nationaler Linienverkehr.\nKapitänin auf dem CRJ-900; frühere Muster: CRJ-Serie, Embraer 195, Airbus A340-300.",
    icon: "✈️",
    quote: "",
  },
  {
    years: "2022",
    title: "Ausbildungen zur Bewegungs- und Lebensstilcoaching",
    place: "Benvitaal Academie, Online Kurs",
    text: "Bewegungscoach, Ernährungscoach und Lebensstilcoach. Fokus auf Prävention und Gesundheitsförderung.",
    icon: "🏃‍♀️",
    quote: "",
  },
  {
    years: "2021",
    title: "IT-Weiterbildungen",
    place: "Bit Academy, TechGrounds, Avans+, Codaisseur u. a. Online Kurse",
    text: "Full Stack Web Development, Data Engineering, objektorientierte Programmierung.\nDesign Thinking und Scrum Master (PSM1).",
    icon: "📚",
    quote: "",
  },
  {
    years: "2019 – 2020",
    title: "Ausbildung zur Mediatorin",
    place: "Zentrum für Mediation, Steyerberg",
    text: "Zertifizierte Mediatorin (BM-Richtlinien).",
    icon: "🤝",
    quote: "",
  },

  {
    years: "1997 – 2000",
    title: "Verkehrspilotenausbildung (ATPL)",
    place: "Nationale Flugschule, Enschede",
    text: "Praktikum in Venice, Florida. Abschluss ATPL nach JAR-FCL.",
    icon: "🛫",
    quote: "",
  },
  {
    years: "1996 – 1997",
    title: "Mitarbeiterin Sicherheitsabteilung",
    place: "PBNA, Arnhem",
    text: "Verwaltung von Kundendaten, Organisation und Abwicklung von Sicherheitsprüfungen.",
    icon: "🔒",
    quote: "",
  },
  {
    years: "1995 – 1996",
    title: "Physiotherapeutin",
    place: "Praxis Rick de Vries, Hamminkeln",
    text: "Behandlung von Patienten mit Massage, Training und verschiedenen Therapieformen.",
    icon: "🤲",
    quote: "",
  },
  {
    years: "1991 – 1995",
    title: "Studium Physiotherapie",
    place: "HAN Hochschule, Arnhem/Nijmegen",
    text: "Bachelor-Abschluss in Physiotherapie.",
    icon: "🎓",
    quote: "",
  },
];
---

<BaseLayout title="Lebenslauf">
  <section class="content cv-page">
    <h1>Lebenslauf</h1>
    <p>
      Mein Weg in Stationen – vom Behandlungsraum über das Cockpit bis zum Code.
    </p>

    <ol class="timeline">
      {timeline.map((item) => (
        <li class="timeline-item">
          <span class="timeline-icon" aria-hidden="true">
            {item.icon}
          </span>
          <p class="timeline-years">{item.years}</p>
          <h2>{item.title}</h2>
          {item.place && <p class="timeline-place">{item.place}</p>}
          {item.text && <p class="timeline-text">{item.text}</p>}
          {item.quote && <p class="timeline-quote">{item.quote}</p>}
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  /* Wider column for the CV */
  .cv-page {
    max-width: 56rem;
  }

  /* Vertical line on the left */
  .timeline {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    border-left: 2px solid var(--color-soft);
  }

  .timeline-item {
    position: relative;
    padding: 0 0 2.5rem 2.75rem;
  }

  /* Round icon on the line */
  .timeline-icon {
    position: absolute;
    top: 0;
    left: calc(-1.25rem - 1px);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 3px solid var(--color-background);
    border-radius: 50%;
    background: var(--color-soft);
    font-size: 1.2rem;
  }

  /* Personal sentence */
  .timeline-quote {
    margin-top: 0.75rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
    font-family: var(--font-headings);
    font-style: italic;
    font-size: 1.1rem;
  }

  /* Fade in while scrolling (only when JavaScript works) */
  .timeline.animate .timeline-item {
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.8s,
      transform 0.8s;
  }

  .timeline.animate .timeline-item.visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline.animate .timeline-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .timeline-years {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .timeline-item h2 {
    white-space: pre-line;
    margin: 0.25rem 0;
    font-size: 1.3rem;
  }

  .timeline-place {
    margin: 0;
    font-style: italic;
  }

  /* Allow line breaks (\n) in the text */
  .timeline-text {
    white-space: pre-line;
  }
</style>

<script>
  // Let each period fade in when it scrolls into view
  const timeline = document.querySelector(".timeline");

  if (timeline && "IntersectionObserver" in window) {
    timeline.classList.add("animate");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          // Visible while in view, hidden again when it leaves
          entry.target.classList.toggle("visible", entry.isIntersecting);
        });
      },
      { threshold: 0.2 },
    );

    timeline.querySelectorAll(".timeline-item").forEach((item) => {
      observer.observe(item);
    });
  }
</script>
