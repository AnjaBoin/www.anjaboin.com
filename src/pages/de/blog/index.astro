---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'de';

// All German posts, newest first
const posts = (await getCollection('blog'))
  .filter((post) => post.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BlogLayout title="Blog">
  <h1>Blog</h1>

  <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <a href={`/${lang}/blog/${post.id.replace(`${lang}/`, '')}/`}>
            {post.data.image && (
              <img src={post.data.image} alt={post.data.imageAlt ?? ''} />
            )}
            <h2>{post.data.title}</h2>
          </a>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('de-DE', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </time>
          <p>{post.data.description}</p>
        </li>
      ))}
      </ul>
</BlogLayout>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Each post with a line below */
  .post-item {
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-soft);
  }

  .post-item a {
    color: var(--color-text);
    text-decoration: none;
  }

  .post-item a:hover h2 {
    color: var(--color-accent);
  }

  .post-item img {
    display: block;
    width: 100%;
    height: 14rem;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  .post-item h2 {
    margin: 1rem 0 0.25rem;
  }

  .post-item time {
    font-size: 0.9rem;
    color: var(--color-accent);
  }
</style>