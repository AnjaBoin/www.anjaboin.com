---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';

// Make one page for every German post
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => post.id.startsWith('nl/'))
    .map((post) => ({
      params: { slug: post.id.replace('nl/', '') },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout title={post.data.title}>
  {post.data.image && (
    <img class="post-image" src={post.data.image} alt={post.data.imageAlt ?? ''} />
  )}

  <h1>{post.data.title}</h1>

  <time datetime={post.data.pubDate.toISOString()}>
    {post.data.pubDate.toLocaleDateString('nl-NL', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })}
  </time>

  <Content />

  <p class="back-link"><a href="/nl/blog/">← Terug naar de blog</a></p>
</BlogLayout>

<style>
  .post-image {
    display: block;
    width: 100%;
    max-height: 24rem;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  time {
    font-size: 0.9rem;
    color: var(--color-accent);
  }

  .back-link {
    margin-top: 3rem;
  }
</style>