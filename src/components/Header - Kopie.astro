---
import { t } from "../i18n/ui.js";

const lang = Astro.currentLocale ?? "de";
const currentPath = Astro.url.pathname;

const links = [
    { href: `/${lang}/`, label: t(lang, "nav.home") },
    { href: `/${lang}/about/`, label: t(lang, "nav.about") },
];
---

<header class="site-header">
    <a href={`/${lang}/`} class="site-name">
        Anja Boin
    </a>

    <nav aria-label={t(lang, "nav.label")}>
        <ul class="nav-list">
            {links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        aria-current={
                            currentPath === link.href ? "page" : undefined
                        }
                    >
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</header>

<style>
    /* Name on the left, menu on the right */
    .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 1.25rem 2rem;
        border-bottom: 1px solid var(--color-soft);
    }

    /* The name */
    .site-name {
        font-family: var(--font-headings);
        font-size: 1.5rem;
        color: var(--color-text);
        text-decoration: none;
    }

    /* Menu items next to each other, without bullets */
    .nav-list {
        display: flex;
        gap: 1.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav-list a {
        color: var(--color-text);
        text-decoration: none;
    }

    /* Hover: accent color */
    .nav-list a:hover {
        color: var(--color-accent);
    }

    /* The page you are on */
    .nav-list a[aria-current="page"] {
        color: var(--color-accent);
        border-bottom: 2px solid var(--color-accent);
    }
</style>
