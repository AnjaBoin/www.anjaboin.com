---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import { t } from '../i18n/ui.js';

const { title } = Astro.props;
const lang = Astro.currentLocale ?? 'de';
const currentPath = Astro.url.pathname;

// The 5 newest posts in the current language
const recentPosts = (await getCollection('blog'))
  .filter((post) => post.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout title={title}>
  <div class="blog-layout">
    <!-- Middle: the article itself -->
    <article class="blog-main">
      <slot />
    </article>

    <!-- Left: latest articles -->
    <aside class="blog-recent" aria-labelledby="recent-heading">
      <h2 id="recent-heading">{t(lang, 'blog.recent')}</h2>
      <ul>
        {recentPosts.map((post) => {
          const href = `/${lang}/blog/${post.id.replace(`${lang}/`, '')}/`;
          return (
            <li>
              <a href={href} aria-current={currentPath === href ? 'page' : undefined}>
                {post.data.image && <img src={post.data.image} alt="" />}
                <span>{post.data.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </aside>

    <!-- Right: fixed information about me -->
    <aside class="blog-about" aria-labelledby="about-heading">
      <img class="about-photo" src="/images/anja-hero.jpg" alt="Anja Boin" />
      <h2 id="about-heading">{t(lang, 'blog.aboutTitle')}</h2>
      <p>{t(lang, 'blog.aboutText')}</p>
      <a href={`/${lang}/about/`}>{t(lang, 'blog.aboutLink')}</a>
    </aside>
  </div>
</BaseLayout>

<style>
  /* Three columns: latest | article | about me */
  .blog-layout {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr) 14rem;
    grid-template-areas: "recent main about";
    gap: 3rem;
    max-width: 75rem;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .blog-main {
    grid-area: main;
  }

  .blog-recent {
    grid-area: recent;
  }

  .blog-about {
    grid-area: about;
  }

  /* Small headings above the side columns */
  aside h2 {
    margin-top: 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Left column: list of articles */
  .blog-recent ul {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog-recent a {
    display: block;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-text);
    text-decoration: none;
  }

  .blog-recent img {
    display: block;
    width: 100%;
    height: 7rem;
    margin-bottom: 0.4rem;
    object-fit: cover;
    border-radius: 0.4rem;
  }

  .blog-recent a:hover,
  .blog-recent a[aria-current="page"] {
    color: var(--color-accent);
  }

  /* Right column: soft block about me */
  .blog-about {
    align-self: start;
    padding: 1.5rem;
    background: var(--color-soft);
    border-radius: 0.5rem;
  }

  .about-photo {
    display: block;
    width: 6rem;
    height: 6rem;
    margin-bottom: 1rem;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 50%;
  }

  .blog-about p {
    font-size: 0.95rem;
  }

  /* Smaller screens: everything below each other, article first */
  @media (max-width: 60rem) {
    .blog-layout {
      grid-template-columns: 1fr;
      grid-template-areas:
        "main"
        "recent"
        "about";
      padding: 2rem 1.25rem;
    }
  }
</style>